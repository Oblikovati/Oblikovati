#version 450
// Software single-bounce, single-light direct-lighting harness (M45-F04 PBI-346,
// ADR-0053): the compute-shader-BVH counterpart of pathtrace.rgen/.rchit/.rmiss —
// same F03 GLSL BSDF library (openpbr/base_lobes.glsl), same shading math, only the
// intersection call differs (BVH traversal via a plain buffer, not an acceleration
// structure/ray query). A compute shader has no ray-gen/closest-hit/miss STAGE
// separation, so both the primary and shadow queries are ordinary function calls
// within one shader body instead of two traceRayEXT dispatches into separate stages.
#extension GL_GOOGLE_include_directive : require
#include "openpbr/base_lobes.glsl"
#include "sw_bvh_types.glsl"

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform CameraParams {
    vec3 origin;
    float tMin;
    vec3 direction;
    float tMax;
} cam;

layout(set = 0, binding = 1, std430) readonly buffer Nodes { BVHNode nodes[]; };
layout(set = 0, binding = 2, std430) readonly buffer TriOrder { int triOrder[]; };
layout(set = 0, binding = 3, std430) readonly buffer Triangles { GpuTriangle tris[]; };

layout(set = 0, binding = 4) uniform Params {
    vec3 lightPos;
    float lightIntensity;
    vec3 lightColor;
    float pad0;
    vec3 baseColor;
    float baseWeight;
    float specularRoughness;
    float specularIOR;
    float baseMetalness;
    float pad1;
} params;

layout(set = 0, binding = 5, std430) buffer Output { vec4 radiance; } outputBuf;

#include "sw_bvh_traverse.glsl"

void buildBasis(vec3 n, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(n.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    tangent = normalize(cross(up, n));
    bitangent = cross(n, tangent);
}

void main() {
    outputBuf.radiance = vec4(0.0);

    TraceResult primary = traceBVH(cam.origin, cam.direction, cam.tMin, cam.tMax);
    if (!primary.hit) return;

    vec3 hitPoint = cam.origin + cam.direction * primary.t;
    vec3 normal = primary.normal;

    vec3 toLight = params.lightPos - hitPoint;
    float dist = length(toLight);
    vec3 wi = toLight / dist;
    vec3 wo = -cam.direction;

    TraceResult shadow = traceBVH(hitPoint + normal * 1e-3, wi, 1e-3, dist - 2e-3);
    if (shadow.hit) return; // occluded: radiance stays 0

    vec3 tangent, bitangent;
    buildBasis(normal, tangent, bitangent);
    vec3 wiLocal = vec3(dot(wi, tangent), dot(wi, bitangent), dot(wi, normal));
    vec3 woLocal = vec3(dot(wo, tangent), dot(wo, bitangent), dot(wo, normal));
    if (wiLocal.z <= 0.0 || woLocal.z <= 0.0) return;

    float alpha = openpbrAlphaFromRoughness(params.specularRoughness);
    // See pathtrace.rchit's identical note: base_diffuse_roughness isn't exposed by this
    // harness yet, fixed at the spec's own Lambertian default (0).
    vec3 diffuse = openpbrDiffuseSingleScatter(params.baseColor * params.baseWeight, 0.0, wiLocal, woLocal);

    vec3 h = normalize(wiLocal + woLocal);
    float d = openpbrDistributionGGX(h, alpha);
    float g = openpbrSmithG2(wiLocal, woLocal, alpha);
    float fr = openpbrDielectricFresnel(params.specularIOR, max(dot(wiLocal, h), 0.0));
    float specular = fr * d * g / (4.0 * wiLocal.z * woLocal.z);

    vec3 brdf = diffuse + vec3(specular);
    float attenuation = params.lightIntensity / (dist * dist);
    float cosTheta = wiLocal.z;
    outputBuf.radiance = vec4(brdf * params.lightColor * attenuation * cosTheta, 1.0);
}
